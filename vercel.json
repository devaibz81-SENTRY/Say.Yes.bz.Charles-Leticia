{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "(/.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "(/.*)\\.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "(/.*)\\.jpeg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "(/.*)\\.woff2",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/Pages/admin.html" },
    { "source": "/admin/", "destination": "/Pages/admin.html" },
    { "source": "/invite/:slug", "destination": "/single.html" },
    { "source": "/single/:slug", "destination": "/single.html" },
    { "source": "/couple/:slug", "destination": "/couple.html" },
    { "source": "/single.html/:slug", "destination": "/single.html" }
  ]
}
